rules_version = '2';

// Le Baron — règles Firestore.
//
// À copier-coller dans : console.firebase.google.com → votre projet →
// Firestore Database → onglet "Règles" → remplacer le contenu → Publier.
//
// Logique :
//  - "events" (l'agenda) : lecture publique (le site public l'affiche),
//    écriture réservée aux comptes gérants connectés (admin.html).
//  - "clients" (le CRM VIP) : entièrement réservé aux comptes gérants —
//    jamais touché par le site public.
//  - "boissons" (catalogue boissons/cocktails), "depenses" (dépenses par
//    catégorie : boîte, bar, carré VIP, cigar hall) et "ventesBoissons"
//    (comptes rendus boissons vendues) : entièrement réservés aux comptes
//    gérants, comme "clients" — jamais touchés par le site public.
//  - "produits" (fiches produit par département : Boîte, Salle VIP, Cigar
//    Hall, Bar) et "mouvements" (historique des entrées de stock et des
//    ventes, avec quantité et montant) : entièrement réservés aux comptes
//    gérants — c'est ce que le gérant saisit depuis admin.html et que le
//    boss consulte depuis boss.html (avec les mêmes identifiants gérant).
//  - "reservations", "guestlist", "tickets", "privatizations",
//    "newsletter" : n'importe qui peut CRÉER un document (c'est ce que
//    font les formulaires du site public), mais seule une session gérant
//    connectée peut les LIRE, les MODIFIER (confirmer/refuser/scanner) ou
//    les SUPPRIMER. Un visiteur ne peut donc jamais relire les demandes
//    des autres, ni changer leur statut.
//  - "_setup/adminCreated" : verrou "usage unique" pour la page
//    creer-gerant.html (premier compte gérant, sans connexion préalable).
//    Le document ne peut être créé qu'une seule fois ; une fois créé,
//    personne (même connecté) ne peut plus le modifier ou le supprimer —
//    c'est ce qui rend la page réellement à usage unique, pas juste en
//    apparence côté JavaScript.
//  - Tout le reste est bloqué par défaut.

service cloud.firestore {
  match /databases/{database}/documents {

    // Le boss = ce compte (même liste que js/roles.js). Tous les autres
    // comptes connectés sont des gérants.
    function isBoss() {
      return request.auth != null
        && request.auth.token.email.lower() in ['baron@gmail.com'];
    }
    // Mouvement encore dans la fenêtre de modification libre (10 min).
    function dansLeDelai(d) {
      return request.time.toMillis() - d.createdAt < 600000;
    }
    function autorise(d) {
      return d.get('modificationAutorisee', false) == true;
    }

    match /_setup/adminCreated {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/_setup/adminCreated);
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }

    match /boissons/{boissonId} {
      allow read, write: if request.auth != null;
    }

    match /depenses/{depenseId} {
      allow read, write: if request.auth != null;
    }

    match /ventesBoissons/{venteId} {
      allow read, write: if request.auth != null;
    }

    match /produits/{produitId} {
      allow read, write: if request.auth != null;
    }

    // Mouvements de stock : le verrou de 10 minutes et l'autorisation du
    // boss sont appliqués ICI, côté serveur (pas seulement dans la page).
    match /mouvements/{mouvementId} {
      allow read: if request.auth != null;
      // création : horodatage cohérent avec l'heure du serveur (±5 min),
      // et jamais créé "déjà autorisé".
      allow create: if request.auth != null
        && request.resource.data.createdAt is number
        && request.resource.data.createdAt > request.time.toMillis() - 300000
        && request.resource.data.createdAt < request.time.toMillis() + 300000
        && request.resource.data.get('modificationAutorisee', false) == false;
      allow update: if (
          // le boss ne peut que poser/retirer l'autorisation
          isBoss()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['modificationAutorisee', 'updatedAt'])
        ) || (
          // le gérant : dans le délai, ou une fois si le boss a autorisé ;
          // il ne peut ni s'autoriser lui-même ni changer la date de saisie
          request.auth != null
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('modificationAutorisee', false) == false
          && (dansLeDelai(resource.data) || autorise(resource.data))
        );
      allow delete: if request.auth != null
        && (dansLeDelai(resource.data) || autorise(resource.data));
    }

    // Journal des modifications : on peut y ajouter, jamais le changer
    // ni l'effacer.
    match /historique_modifications/{modId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /{col}/{docId} {
      allow create: if col in ['reservations', 'guestlist', 'tickets', 'privatizations', 'newsletter'];
      allow read, update, delete: if request.auth != null
        && col in ['reservations', 'guestlist', 'tickets', 'privatizations', 'newsletter'];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
